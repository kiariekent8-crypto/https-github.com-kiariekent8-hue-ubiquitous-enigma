# Example environment variables for local debug runs

# RPC provider that supports forking (Infura/Alchemy). Keep this secret.
RPC_URL="https://mainnet.infura.io/v3/YOUR_INFURA_KEY"

# Local private key for testing only. DO NOT commit to repo.
# Use a low-value or test account for debugging.
PRIVATE_KEY="0xYOUR_PRIVATE_KEY"

# Token address to debug (defaults to EUG)
TOKEN_ADDRESS="0x4E9893B14B15A2f938dbc44BB427ef6Cd858CFec"

# Recipient example for sending ETH
RECIPIENT="0x1C4CAda724b333ee65F8640FaBFb658550Ad5F18"

# Amounts for addLiquidity and swaps
TOKEN_AMOUNT="100000"
ETH_AMOUNT="1"

# Slippage settings
SLIPPAGE_PERCENT="1"

# Gas settings
GAS_BUFFER_ETH="0.01"
GAS_LIMIT="450000"
